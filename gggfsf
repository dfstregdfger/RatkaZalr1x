local apartmentsFolder = createFolder("Apartments", city)

local function createApartment(pos, color, width, height, depth, style)
	local building = createPart(apartmentsFolder, "Apartment", Vector3.new(width, height, depth), pos, color, Enum.Material.Brick)
	
	-- Вікна
	local windowColor = "Sky blue"
	local windowMaterial = Enum.Material.Glass
	for i = -width/2 + 2, width/2 - 2, 4 do
		for j = 1, math.floor(height/3) - 1, 2 do
			local window = createPart(apartmentsFolder, "Window", Vector3.new(3, 3, 0.3), 
				Vector3.new(pos.X + i, pos.Y + j * 2, pos.Z + depth/2 + 0.1), windowColor, windowMaterial, 0.4)
			local windowBack = createPart(apartmentsFolder, "WindowBack", Vector3.new(3, 3, 0.3), 
				Vector3.new(pos.X + i, pos.Y + j * 2, pos.Z - depth/2 - 0.1), windowColor, windowMaterial, 0.4)
		end
	end
	
	-- Балкони
	if style == "modern" then
		for i = -width/2 + 3, width/2 - 3, 5 do
			local balcony = createPart(apartmentsFolder, "Balcony", Vector3.new(4, 0.2, 2), 
				Vector3.new(pos.X + i, pos.Y + height/2 - 2, pos.Z + depth/2 + 1), "Light grey", Enum.Material.Concrete)
			local railing = createPart(apartmentsFolder, "Railing", Vector3.new(4, 1, 0.2), 
				Vector3.new(pos.X + i, pos.Y + height/2 - 1, pos.Z + depth/2 + 2), "Dark grey", Enum.Material.Metal)
		end
	end
	
	-- Дах
	local roofColor = style == "modern" and "Dark grey" or "Bright red"
	local roof = createPart(apartmentsFolder, "Roof", Vector3.new(width + 1, 1, depth + 1), 
		Vector3.new(pos.X, pos.Y + height/2 + 0.5, pos.Z), roofColor, Enum.Material.Wood)
	
	return building
end

