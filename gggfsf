-- Функція створення дороги з розміткою
local function createHighway(pos, size, rotation)
	local road = createPart(roadsFolder, "Highway", size, pos, "Really black", Enum.Material.Concrete)
	
	-- Біла розмітка по центру
	local lineWidth = 0.8
	local lineLength = size.X - 4
	if size.X > size.Z then
		local centerLine = createPart(roadsFolder, "CenterLine", Vector3.new(lineLength, 0.2, lineWidth), 
			Vector3.new(pos.X, pos.Y + 0.3, pos.Z), "White", Enum.Material.Neon)
		-- Переривиста розмітка
		for i = -lineLength/2 + 5, lineLength/2, 15 do
			local dash = createPart(roadsFolder, "Dash", Vector3.new(5, 0.2, lineWidth), 
				Vector3.new(pos.X + i, pos.Y + 0.3, pos.Z), "White", Enum.Material.Neon)
		end
	else
		local centerLine = createPart(roadsFolder, "CenterLine", Vector3.new(lineWidth, 0.2, size.Z - 4), 
			Vector3.new(pos.X, pos.Y + 0.3, pos.Z), "White", Enum.Material.Neon)
		for i = -size.Z/2 + 5, size.Z/2, 15 do
			local dash = createPart(roadsFolder, "Dash", Vector3.new(lineWidth, 0.2, 5), 
				Vector3.new(pos.X, pos.Y + 0.3, pos.Z + i), "White", Enum.Material.Neon)
		end
	end
	
	-- Бічні лінії
	local sideLine1 = createPart(roadsFolder, "SideLine", Vector3.new(size.X, 0.2, 0.5), 
		Vector3.new(pos.X, pos.Y + 0.3, pos.Z + size.Z/2 - 0.8), "White", Enum.Material.Neon)
	local sideLine2 = createPart(roadsFolder, "SideLine", Vector3.new(size.X, 0.2, 0.5), 
		Vector3.new(pos.X, pos.Y + 0.3, pos.Z - size.Z/2 + 0.8), "White", Enum.Material.Neon)
end

