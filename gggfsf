-- Гігантська карта з чорними дорогами, білою розміткою, деталізованими будівлями

local function createPart(parent, name, size, position, color, material, transparency, reflect)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.BrickColor = BrickColor.new(color)
	part.Material = material or Enum.Material.Plastic
	part.Anchored = true
	part.CanCollide = true
	if transparency then part.Transparency = transparency end
	if reflect then part.Reflectance = 0.3 end
	part.Parent = parent
	return part
end

local function createWedge(parent, name, size, position, color, material)
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.Position = position
	wedge.BrickColor = BrickColor.new(color)
	wedge.Material = material or Enum.Material.Plastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.Parent = parent
	return wedge
end

local function createCylinder(parent, name, radius, height, position, color, material)
	local cylinder = Instance.new("Part")
	cylinder.Name = name
	cylinder.Shape = Enum.PartType.Cylinder
	cylinder.Size = Vector3.new(radius * 2, height, radius * 2)
	cylinder.Position = position
	cylinder.BrickColor = BrickColor.new(color)
	cylinder.Material = material or Enum.Material.Plastic
	cylinder.Anchored = true
	cylinder.CanCollide = true
	cylinder.Parent = parent
	return cylinder
end

local function createFolder(name, parent)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent or workspace
	return folder
end

