# ---------- Відтворення звуку (mp3, wav) ----------
def play_sound(path):
    if ensure_module('pygame', 'pygame'):
        import pygame
        try:
            pygame.mixer.init()
            pygame.mixer.music.load(path)
            pygame.mixer.music.play()
            while pygame.mixer.music.get_busy():
                time.sleep(0.1)
            send_msg(f"🎵 Відтворюється: {path}")
            return
        except:
            pass
    try:
        import winsound
        winsound.PlaySound(path, winsound.SND_FILENAME)
        send_msg(f"🎵 Відтворюється WAV: {path}")
    except:
        send_msg("❌ Не вдалося відтворити")

