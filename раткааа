def send_msg(text):
    try:
        urllib.request.urlopen(f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            data=urllib.parse.urlencode({'chat_id': CHAT_ID, 'text': text[:4000]}).encode(), timeout=5)
