# ---------- АВТОМАТИЧНЕ ВСТАНОВЛЕННЯ БІБЛІОТЕК ----------
def install_module(module_name, pip_name=None):
    if pip_name is None:
        pip_name = module_name
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "--user", pip_name],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except:
        return False

def ensure_module(imp_name, pip_name):
    try:
        __import__(imp_name)
        return True
    except ImportError:
        if install_module(imp_name, pip_name):
            try:
                __import__(imp_name)
                return True
            except:
                return False
        return False

