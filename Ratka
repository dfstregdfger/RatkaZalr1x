# ---------- Функції для роботи з Telegram ----------
def send_message(text):
    """Надіслати текстове повідомлення в Telegram"""
    try:
        url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
        data = urllib.parse.urlencode({'chat_id': CHAT_ID, 'text': text[:4000]}).encode()
        urllib.request.urlopen(url, data=data)
    except Exception:
        pass

def send_file(file_path):
    """Надіслати файл в Telegram"""
    try:
        with open(file_path, 'rb') as f:
            boundary = '----WebKitFormBoundary' + str(time.time()).replace('.', '')
            body = []
            body.append(f'--{boundary}\r\n'.encode())
            body.append(f'Content-Disposition: form-data; name="chat_id"\r\n\r\n{CHAT_ID}\r\n'.encode())
            body.append(f'--{boundary}\r\n'.encode())
            body.append(f'Content-Disposition: form-data; name="document"; filename="{os.path.basename(file_path)}"\r\n'.encode())
            body.append(b'Content-Type: application/octet-stream\r\n\r\n')
            body.append(f.read())
            body.append(f'\r\n--{boundary}--\r\n'.encode())
            req = urllib.request.Request(f"https://api.telegram.org/bot{TOKEN}/sendDocument", data=b''.join(body))
            req.add_header('Content-Type', f'multipart/form-data; boundary={boundary}')
            urllib.request.urlopen(req)
    except Exception:
        pass

