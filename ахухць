def shutdown_pc(delay=30):
    os.system(f"shutdown /s /t {delay} /c \"Ваш комп'ютер буде вимкнено через {delay} секунд за командою з Telegram\"")
    return f"✅ Комп'ютер вимкнеться через {delay} секунд"

def restart_pc(delay=30):
    os.system(f"shutdown /r /t {delay} /c \"Ваш комп'ютер буде перезавантажено через {delay} секунд за командою з Telegram\"")
    return f"✅ Комп'ютер перезавантажиться через {delay} секунд"

def abort_shutdown():
    os.system("shutdown /a")
    return "✅ Вимкнення скасовано"

