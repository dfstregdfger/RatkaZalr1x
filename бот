            await callback.message.answer(f"🎯 Сьогодні: {random.choice(days)}!")
        
        elif data == "current_time":
            await callback.message.answer(f"⏰ Час: {datetime.now().strftime('%H:%M:%S')}")
        
        elif data == "current_date":
            await callback.message.answer(f"📅 Дата: {datetime.now().strftime('%d.%m.%Y')}")
        
        elif data == "my_ip":
            async with aiohttp.ClientSession() as session:
                async with session.get('https://api.ipify.org') as resp:
                    ip = await resp.text()
