# ---------- API ФУНКЦІЇ ----------
async def fetch_api(url):
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, timeout=10) as resp:
                if resp.status == 200:
                    return await resp.json()
        except:
            return None

async def get_cat():
    data = await fetch_api('https://api.thecatapi.com/v1/images/search')
    return data[0]['url'] if data else 'https://cataas.com/cat'

async def get_dog():
    data = await fetch_api('https://random.dog/woof.json')
    return data['url'] if data else 'https://images.dog.ceo/breeds/hound-english/n02089973_1.jpg'

